{
  "manifest_version": 3,
  "name": "Drop It",
  "version": "0.2.8",
  "description": "Save pages, selected text, and links to your private Drop It library.",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage",
    "identity"
  ],
  "host_permissions": ["https://dontdropit.app/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Drop It",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" }
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src https://dontdropit.app"
  }
}
