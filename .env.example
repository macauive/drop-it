# Local defaults work without this file. Never put real values in this example.
PORT=4317
PUBLIC_URL=http://localhost:4317
DATA_DIR=.data
# Optional hosted Postgres; omit for embedded Postgres on local disk.
DATABASE_URL=
# Exact OAuth callback URLs from your ChatGPT connection, comma-separated.
OAUTH_REDIRECT_URIS=
# Optional AI drafting and semantic search. Real values belong only in private/.env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
ACCOUNT_MODE=private
ALLOW_SIGNUP=false
# Only behind a trusted reverse proxy which replaces forwarding headers.
TRUST_PROXY_HOPS=0
# Complete real publisher/contact/backup facts to enable public information pages.
PUBLIC_PUBLISHER_NAME=
PUBLIC_SUPPORT_EMAIL=
BACKUP_RETENTION_DAYS=
# Exact public verification challenge from the OpenAI submission portal.
OPENAI_APPS_CHALLENGE=
# For hosted access: use HTTPS PUBLIC_URL, NODE_ENV=production, persistent DATA_DIR,
# and configure the owner locally before exposing the service. See README.md.

# Sign in with ChatGPT: disabled until OpenAI provisions a commercial OAuth client.
# Callback registered with OpenAI must be PUBLIC_URL/auth/chatgpt/callback.
CHATGPT_ENABLED=false
CHATGPT_CLIENT_ID=
CHATGPT_TOKEN_AUTH_METHOD=none
CHATGPT_CLIENT_SECRET=
# Independent random 32-byte key encoded as 64 hex characters. Keep in secret manager.
CHATGPT_ENCRYPTION_KEY=
# Separate approval is required. Use exactly the scopes provisioned by OpenAI.
# Enabling plan mode requires every account to connect its own plan for drafts;
# keyword search remains available, and the site API key is never a fallback.
CHATGPT_PLAN_ENABLED=false
CHATGPT_PLAN_SCOPES=
